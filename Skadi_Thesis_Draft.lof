\contentsline {figure}{\numberline {5.1}{\ignorespaces $p+p\rightarrow q \bar {q} + X$ events, these dijet-types are possible to be produced from gluon or quark interchange, probing the square of the gluon or quark distributions\relax }}{22}{figure.caption.16}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces $p+p\rightarrow gg + X$ events, these dijet-types are possible to be produced from gluon or quark interchange, probing the square of the gluon or quark distributions\relax }}{22}{figure.caption.17}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces $p+p\rightarrow gq \left (\bar {q} \right ) + X$ events, these dijet-types are possible only via quark (antiquark) and gluon interactions, hence probing both gluon and quark distributions at once\relax }}{22}{figure.caption.18}%
